REDTEAM_SIGNING_KEY=change-me-in-dev
# Tracing LangSmith (facultatif) : sans clé, le PoC reste 100 % hors ligne.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=redteam-ia
